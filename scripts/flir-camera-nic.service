[Unit]
Description=Prepare the FLIR GigE camera NIC (host address, socket buffers, RX ring, ptp4l caps)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/ircv/DM/FLIR_control/scripts/setup_camera_nic.bash

[Install]
WantedBy=multi-user.target
